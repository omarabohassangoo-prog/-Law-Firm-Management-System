{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users and clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["ADMIN", "LAWYER", "PARALEGAL", "ACCOUNTANT", "SECRETARY", "CLIENT"] },
        "tenantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role", "tenantId"]
    },
    "Case": {
      "title": "Case",
      "description": "Legal cases",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "caseNumber": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "PENDING", "CLOSED", "ARCHIVED"] },
        "clientId": { "type": "string" },
        "lawyerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "caseNumber", "title", "status", "clientId", "lawyerId"]
    },
    "Task": {
      "title": "Task",
      "description": "Law firm tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "caseId": { "type": "string" },
        "assigneeId": { "type": "string" },
        "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "DONE"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "assigneeId", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Client invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "clientId": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "SENT", "PAID", "OVERDUE"] }
      },
      "required": ["id", "invoiceNumber", "clientId", "total", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Security logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/cases/{caseId}": {
      "schema": "Case",
      "description": "Legal cases"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Security logs"
    },
    "/templates/{templateId}": {
      "schema": "PrintTemplate",
      "description": "Templates"
    }
  }
}
