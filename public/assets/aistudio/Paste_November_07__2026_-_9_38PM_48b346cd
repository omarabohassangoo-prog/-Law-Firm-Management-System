  if (f && f.size > env.MAX_UPLOAD_BYTES) return res.status(413).json({ error: 'too_large' });
  if (f) {
    const allowed = ['application/pdf', 'image/png', 'image/jpeg', 'text/plain'];
    if (!allowed.includes(f.mimetype)) return res.status(415).json({ error: 'unsupported_type' });
  }
  const content = f ? readFileSync(f.path) : Buffer.from(req.body.content ?? '');
  const doc = await prisma.document.create({
    data: {
      title: req.body.title ?? f?.originalname ?? 'Document',
      filePath: f?.path ?? null,
      mimeType: f?.mimetype ?? 'application/octet-stream',
      size: f?.size ?? content.length,
      checksum: sha256(content),
      ownerId: req.user!.id,
      caseId: caseId || null,
      encrypted: !!req.body.encrypted,
    },
  });
  res.status(201).json(doc);
}));

