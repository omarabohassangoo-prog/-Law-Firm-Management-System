import type { Response, NextFunction } from 'express';
import type { AuthedRequest } from './auth';
import { prisma } from '../db/prisma';
import { hashChain, sha256 } from '../utils/crypto';

export function audit(action: string, entity?: string) {
  return async (req: AuthedRequest, res: Response, next: NextFunction) => {
    res.on('finish', async () => {
      if (res.statusCode >= 400) return;
      try {
        const last = await prisma.auditLog.findFirst({ orderBy: { createdAt: 'desc' } });
        const prevHash = last?.hash ?? null;
        const payload = `${req.user?.id ?? 'anon'}|${action}|${entity ?? ''}|${Date.now()}`;
        const hash = hashChain(prevHash, payload);
        await prisma.auditLog.create({
          data: {
            userId: req.user?.id,
            action, entity,
            entityId: req.params?.id ?? null,
            ip: req.ip, userAgent: req.headers['user-agent'] as string ?? null,
            meta: { path: req.originalUrl, method: req.method } as any,
            prevHash, hash,
          },
        });
      } catch { /* noop */ }
    });
    next();
  };
}
