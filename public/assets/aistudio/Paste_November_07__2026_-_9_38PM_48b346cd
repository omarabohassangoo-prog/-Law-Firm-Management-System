  const rt = req.cookies?.refresh_token;
  if (!rt) return res.status(401).json({ error: 'no_refresh' });
  let payload;
  try { payload = verifyRefresh(rt); } catch { return res.status(401).json({ error: 'invalid_refresh' }); }
  const session = await prisma.session.findFirst({
    where: { userId: payload.sub, refreshToken: payload.jti, revokedAt: null },
  });
  if (!session) return res.status(401).json({ error: 'session_revoked' });
  const fp = (req as any).fingerprint || '';
  if (fp && fp !== session.fingerprint) {
    await prisma.session.update({ where: { id: session.id }, data: { revokedAt: new Date() } });
    return res.status(403).json({ error: 'fingerprint_mismatch' });
  }
  const user = await prisma.user.findUnique({ where: { id: payload.sub } });
  if (!user) return res.status(401).json({ error: 'unauthorized' });
  const newJti = randomToken(16);
  const access = signAccess({ sub: user.id, role: user.role, fp: session.fingerprint });
  const refresh = signRefresh({ sub: user.id, jti: newJti, fp: session.fingerprint });
  await prisma.session.update({ where: { id: session.id }, data: { refreshToken: newJti } });
  setAuthCookies(res, access, refresh);
  res.json({ ok: true });
}));

