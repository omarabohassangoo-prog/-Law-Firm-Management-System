// src/utils/jwt.ts
import jwt from 'jsonwebtoken';
import { env } from '../config/env';

export interface AccessPayload { sub: string; role: string; fp: string; }
export interface RefreshPayload { sub: string; jti: string; fp: string; }

export const signAccess = (p: AccessPayload) =>
  jwt.sign(p, env.JWT_SECRET, { expiresIn: env.ACCESS_TTL as any });

export const signRefresh = (p: RefreshPayload) =>
  jwt.sign(p, env.JWT_REFRESH_SECRET, { expiresIn: `${env.REFRESH_TTL_DAYS}d` });

export const verifyAccess = (t: string) => jwt.verify(t, env.JWT_SECRET) as AccessPayload;
export const verifyRefresh = (t: string) => jwt.verify(t, env.JWT_REFRESH_SECRET) as RefreshPayload;
```

