// src/utils/crypto.ts
import { createHash, createHmac, randomBytes } from 'node:crypto';
import { env } from '../config/env';

export const sha256 = (d: string | Buffer) => createHash('sha256').update(d).digest('hex');
export const hmac = (d: string) => createHmac('sha256', env.JWT_SECRET).update(d).digest('hex');
export const randomToken = (n = 32) => randomBytes(n).toString('hex');
export const hashChain = (prev: string | null, current: string) => sha256(`${prev ?? ''}${current}`);
