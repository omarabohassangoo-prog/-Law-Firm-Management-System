// src/utils/email.ts
import nodemailer from 'nodemailer';
import { env } from '../config/env';
import { logger } from './logger';

const transport = env.SMTP_URL
  ? nodemailer.createTransport(env.SMTP_URL)
  : nodemailer.createTransport({ jsonTransport: true });

export async function sendEmail(to: string, subject: string, html: string, text?: string) {
  try {
    const info = await transport.sendMail({ from: 'noreply@firm.test', to, subject, html, text });
    logger.info('Email sent', { to, id: info.messageId });
    return { id: info.messageId };
  } catch (e) {
    logger.error('Email failed', e);
    throw e;
  }
}

export function renderTemplate(tpl: string, vars: Record<string, any>) {
  return tpl.replace(/\{\{\s*(\w+)\s*\}\}/g, (_, k) => String(vars[k] ?? ''));
}
