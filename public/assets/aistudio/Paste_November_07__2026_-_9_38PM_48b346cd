```typescript
// src/seed.ts
import { prisma } from './db/prisma';
import { hashPassword } from './utils/password';

const USERS = [
  { email: 'admin@firm.test',      password: 'Admin@12345',      name: 'Admin',      role: 'ADMIN'      as const },
  { email: 'lawyer@firm.test',     password: 'Lawyer@12345',     name: 'Lawyer',     role: 'LAWYER'     as const },
  { email: 'paralegal@firm.test',  password: 'Paralegal@12345',  name: 'Paralegal',  role: 'PARALEGAL'  as const },
  { email: 'accountant@firm.test', password: 'Accountant@12345', name: 'Accountant', role: 'ACCOUNTANT' as const },
  { email: 'secretary@firm.test',  password: 'Secretary@12345',  name: 'Secretary',  role: 'SECRETARY'  as const },
  { email: 'client@firm.test',     password: 'Client@12345',     name: 'Client',     role: 'CLIENT'     as const },
];

export async function seed() {
  for (const u of USERS) {
    const exists = await prisma.user.findUnique({ where: { email: u.email } });
    if (!exists) {
      await prisma.user.create({
        data: {
          email: u.email, name: u.name, role: u.role,
          password: await hashPassword(u.password),
          phone: `+9665${Math.floor(Math.random() * 1e8).toString().padStart(8, '0')}`,
          emailVerifiedAt: new Date(),
        },
      });
    }
  }

  // courts
  if ((await prisma.court.count()) === 0) {
    await prisma.court.createMany({
      data: [
        { name: 'Riyadh General Court', city: 'Riyadh', type: 'GENERAL', efiling: true },
        { name: 'Jeddah Commercial Court', city: 'Jeddah', type: 'COMMERCIAL', efiling: true },
      ],
    });
  }

  // default templates
  const templates = [
    { key: 'welcome', name: 'Welcome', subject: 'Welcome {{name}}', body: '<p>Welcome</p>', variables: ['name'] },
    { key: 'password_reset', name: 'Reset', subject: 'Reset {{url}}', body: '<a href="{{url}}">Reset</a>', variables: ['url'] },
  ];
  for (const t of templates) {
    if (!(await prisma.emailTemplate.findUnique({ where: { key: t.key } }))) {
      await prisma.emailTemplate.create({ data: t });
    }
  }
}
