export function generateSmsCode(phone: string, purpose: string) {
  const code = String(Math.floor(100000 + Math.random() * 900000));
  codes.set(`${phone}:${purpose}`, { code, expiresAt: Date.now() + 5 * 60_000 });
  return code;
}

export function verifySmsCode(phone: string, purpose: string, code: string) {
  const rec = codes.get(`${phone}:${purpose}`);
  if (!rec) return false;
  if (Date.now() > rec.expiresAt) { codes.delete(`${phone}:${purpose}`); return false; }
  if (rec.code !== code) return false;
  codes.delete(`${phone}:${purpose}`);
  return true;
}
