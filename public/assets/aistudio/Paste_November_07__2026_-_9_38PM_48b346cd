const cookieBase = { httpOnly: true, sameSite: 'lax' as const, secure: env.COOKIE_SECURE, path: '/' };

function setAuthCookies(res: any, access: string, refresh: string) {
  res.cookie('access_token', access, { ...cookieBase, maxAge: 15 * 60_000 });
  res.cookie('refresh_token', refresh, { ...cookieBase, maxAge: env.REFRESH_TTL_DAYS * 24 * 3600_000, httpOnly: true });
}

authRouter.post(
  '/login',
  rateLimit({ windowMs: 60_000, max: 10, key: (req) => `${req.ip}:${(req.body as any)?.email ?? ''}` }),
  validate(loginSchema),
  asyncHandler(async (req, res) => {
    const { email, password } = req.body;
    const user = await prisma.user.findUnique({ where: { email } });
    if (!user) return res.status(401).json({ error: 'invalid_credentials' });
    if (user.isLocked && user.lockedUntil && user.lockedUntil > new Date()) {
      return res.status(423).json({ error: 'account_locked' });
    }
    const ok = await verifyPassword(password, user.password);
    if (!ok) {
      const failed = user.failedLogins + 1;
      await prisma.user.update({
        where: { id: user.id },
        data: failed >= 5
          ? { failedLogins: failed, isLocked: true, lockedUntil: new Date(Date.now() + 15 * 60_000) }
          : { failedLogins: failed },
      });
      return res.status(401).json({ error: 'invalid_credentials' });
    }
    const fp = (req as any).fingerprint || `fp-${req.ip}`;
    const jti = randomToken(16);
    const access = signAccess({ sub: user.id, role: user.role, fp });
    const refresh = signRefresh({ sub: user.id, jti, fp });
    await prisma.session.create({
      data: {
        userId: user.id, refreshToken: jti, fingerprint: fp,
        ipAddress: req.ip, userAgent: req.headers['user-agent'] as string,
        expiresAt: new Date(Date.now() + env.REFRESH_TTL_DAYS * 24 * 3600_000),
      },
    });
    await prisma.user.update({ where: { id: user.id }, data: { failedLogins: 0, isLocked: false, lastLoginAt: new Date() } });
    setAuthCookies(res, access, refresh);
    res.json({ user: { id: user.id, email: user.email, name: user.name, role: user.role } });
  }),
);

