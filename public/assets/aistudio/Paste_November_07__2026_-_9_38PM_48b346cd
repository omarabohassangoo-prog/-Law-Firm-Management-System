  const page = Number(req.query.page ?? 1), limit = Math.min(Number(req.query.limit ?? 20), 100);
  const { q, status, sortBy = 'createdAt', order = 'desc' } = req.query as any;
  const where: any = {};
  if (req.user!.role === 'CLIENT') where.clientId = req.user!.id;
  else if (req.user!.role === 'LAWYER') where.lawyerId = req.user!.id;
  else if (!['ADMIN', 'PARALEGAL', 'SECRETARY'].includes(req.user!.role)) where.lawyerId = req.user!.id;
  if (status) where.status = status;
  if (q) where.OR = [{ title: { contains: q, mode: 'insensitive' } }, { caseNumber: { contains: q, mode: 'insensitive' } }];
  const [items, total] = await Promise.all([
    prisma.case.findMany({ where, skip: (page - 1) * limit, take: limit, orderBy: { [sortBy]: order } }),
    prisma.case.count({ where }),
  ]);
  res.json({ items, total, page, limit });
}));

