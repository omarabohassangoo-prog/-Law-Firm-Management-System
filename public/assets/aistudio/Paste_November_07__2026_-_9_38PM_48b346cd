1️⃣ Prisma Schema

```prisma
// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  LAWYER
  PARALEGAL
  ACCOUNTANT
  SECRETARY
  CLIENT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING
  CLOSED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  COMMERCIAL
  FAMILY
  LABOR
  ADMINISTRATIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentMethod {
  PAYPAL
  BANK_TRANSFER
  CASH
  CARD
  ESCROW
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  phone           String?  @unique
  password        String
  name            String
  role            Role
  tenantId        String   @default("default")
  avatarUrl       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  twoFAEnabled    Boolean  @default(false)
  twoFASecret     String?
  isActive        Boolean  @default(true)
  isLocked        Boolean  @default(false)
  failedLogins    Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  preferences     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  lawyerCases     Case[]           @relation("LawyerCases")
  clientCases     Case[]           @relation("ClientCases")
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")
  sentMessages    Message[]        @relation("MessageSender")
  documents       Document[]
  invoices        Invoice[]        @relation("ClientInvoices")
  createdInvoices Invoice[]        @relation("InvoiceCreator")
  appointments    Appointment[]
  signatures      Signature[]
  ethicalWalls    EthicalWall[]    @relation("BlockedUser")
  trustAccounts   TrustAccount[]
  @@index([role])
  @@index([tenantId])
}

model Session {
  id              String   @id @default(uuid())
  userId          String
  refreshToken    String   @unique
  fingerprint     String
  ipAddress       String?
  userAgent       String?
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Case {
  id             String     @id @default(uuid())
  caseNumber     String     @unique
  title          String
  description    String?
  type           CaseType
  status         CaseStatus @default(OPEN)
  clientId       String
  lawyerId       String
  courtId        String?
  opposingParty  String?
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  legalHold      Boolean    @default(false)
  legalHoldReason String?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client         User       @relation("ClientCases", fields: [clientId], references: [id])
  lawyer         User       @relation("LawyerCases", fields: [lawyerId], references: [id])
  court          Court?     @relation(fields: [courtId], references: [id])
  documents      Document[]
  tasks          Task[]
  hearings       Hearing[]
  deadlines      Deadline[]
  invoices       Invoice[]
  evidence       Evidence[]
  efiling        EFiling[]
  ethicalWalls   EthicalWall[]
  conflicts      ConflictCheck[]

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
  @@index([type])
}

model Court {
  id       String @id @default(uuid())
  name     String
  city     String
  type     String
  efiling  Boolean @default(false)
  cases    Case[]
  holidays CourtHoliday[]
}

model CourtHoliday {
  id      String   @id @default(uuid())
  courtId String?
  date    DateTime
  name    String
  court   Court?   @relation(fields: [courtId], references: [id])
}

model Hearing {
  id        String   @id @default(uuid())
  caseId    String
  date      DateTime
  location  String
  notes     String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId])
  @@index([date])
}

model Deadline {
  id       String       @id @default(uuid())
  caseId   String
  type     String
  date     DateTime
  priority TaskPriority
  done     Boolean      @default(false)
  case     Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId, date])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  caseId      String?
  assigneeId  String
  creatorId   String
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  case        Case?        @relation(fields: [caseId], references: [id])
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])
  @@index([assigneeId])
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  recipientId String
  caseId    String?
  subject   String?
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  @@index([senderId])
  @@index([recipientId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model Document {
  id           String    @id @default(uuid())
  title        String
  filePath     String?
  mimeType     String?
  size         Int?
  checksum     String?
  content      String?
  caseId       String?
  ownerId      String
  versions     DocVersion[]
  signatures   Signature[]
  encrypted    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  owner        User      @relation(fields: [ownerId], references: [id])
  case         Case?     @relation(fields: [caseId], references: [id])
  @@index([caseId])
  @@index([ownerId])
}

model DocVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  content    String?
  filePath   String?
  createdBy  String
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, version])
}

model Signature {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  signature  String
  hash       String?
  timestamp  String?
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id])
}

model Invoice {
  id           String        @id @default(uuid())
  invoiceNumber String       @unique
  clientId     String
  caseId       String?
  creatorId    String
  amount       Decimal       @db.Decimal(14, 2)
  taxAmount    Decimal       @default(0) @db.Decimal(14, 2)
  total        Decimal       @db.Decimal(14, 2)
  currency     String        @default("SAR")
  status       InvoiceStatus @default(DRAFT)
  dueDate      DateTime?
  paidAt       DateTime?
  taxId        String?
  zatcaUuid    String?
  createdAt    DateTime      @default(now())
  client       User          @relation("ClientInvoices", fields: [clientId], references: [id])
  creator      User          @relation("InvoiceCreator", fields: [creatorId], references: [id])
  case         Case?         @relation(fields: [caseId], references: [id])
  payments     Payment[]
  @@index([clientId])
  @@index([status])
}

model Payment {
  id         String        @id @default(uuid())
  invoiceId  String?
  amount     Decimal       @db.Decimal(14, 2)
  currency   String        @default("SAR")
  method     PaymentMethod
  externalId String?
  status     String        @default("PENDING")
  meta       Json?
  createdAt  DateTime      @default(now())
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])
  refunds    Refund[]
