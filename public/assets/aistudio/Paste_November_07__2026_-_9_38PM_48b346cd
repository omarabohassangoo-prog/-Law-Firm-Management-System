// src/middleware/rateLimit.ts
import type { Request, Response, NextFunction } from 'express';
import { redis } from '../db/redis';

interface Opts { windowMs: number; max: number; key?: (req: Request) => string; }

export function rateLimit({ windowMs, max, key }: Opts) {
  return async (req: Request, res: Response, next: NextFunction) => {
    const bucket = `rl:${key ? key(req) : req.ip}:${req.route?.path ?? req.path}`;
    try {
      const cur = await redis.incr(bucket);
      if (cur === 1) await redis.pExpire(bucket, windowMs);
      if (cur > max) return res.status(429).json({ error: 'rate_limited' });
    } catch { /* redis down: fail open */ }
    next();
  };
}
