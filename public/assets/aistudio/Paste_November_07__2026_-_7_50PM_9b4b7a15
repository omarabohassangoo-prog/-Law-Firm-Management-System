{
  "public_pages_settings_plan": {
    "metadata": {
      "title": "إعدادات الصفحات العامة + Footer + SEO",
      "version": "1.0.0",
      "scope": "Admin controlled public pages + Footer + SEO",
      "access_level": "admin only",
      "affected_areas": ["Home", "About", "Services", "Contact", "Footer", "SEO", "Public Header"],
      "target": ["AI Studio", "فريق التطوير"]
    },

    "overview": {
      "purpose": "تمكين المدير من التحكم الكامل في كل ما يراه الزائر بدون كود",
      "features": [
        "🎨 تحرير محتوى كل قسم في الصفحات العامة",
        "📄 إدارة الـ Footer (روابط، معلومات، social)",
        "🔍 إعدادات SEO لكل صفحة",
        "🌐 دعم AR/EN لكل حقل",
        "📱 معاينة فورية",
        "🖼️ رفع صور وإدارة الوسائط",
        "💾 حفظ كمسودة أو نشر فوري",
        "🔄 سجل التغييرات (versions)",
        "⚡ Cache invalidation تلقائي",
        "🎯 ربط SEO بـ sitemap + structured data"
      ],
      "design_principles": [
        "🎯 كل ما يراه الزائر = قابل للتحرير",
        "🎯 Live Preview قبل النشر",
        "🎯 AR/EN في كل حقل",
        "🎯 لا كود — تحرير مرئي فقط",
        "🎯 SEO يؤثر على كل الصفحات",
        "🎯 Rollback لأي إصدار"
      ]
    },

    "data_model": {
      "PublicPageSettings": {
        "purpose": "إعدادات كل صفحة عامة",
        "fields": [
          { "name": "id", "type": "uuid PK" },
          { "name": "pageKey", "type": "enum(home|about|services|contact)", "unique": true },
          { "name": "title_ar", "type": "string", "max": 150 },
          { "name": "title_en", "type": "string", "max": 150 },
          { "name": "subtitle_ar", "type": "string?", "max": 300 },
          { "name": "subtitle_en", "type": "string?", "max": 300 },
          { "name": "heroImage", "type": "string? (URL)" },
          { "name": "heroVideo", "type": "string? (URL)" },
          { "name": "sections", "type": "json (array of section configs)" },
          { "name": "status", "type": "enum(draft|published|archived)", "default": "published" },
          { "name": "lastPublishedAt", "type": "datetime?" },
          { "name": "publishedById", "type": "uuid? FK → User" },
          { "name": "updatedById", "type": "uuid FK → User" },
          { "name": "updatedAt", "type": "datetime" },
          { "name": "createdAt", "type": "datetime" }
        ],
        "indexes": ["pageKey", "status"]
      },

      "FooterSettings": {
        "purpose": "إعدادات الـ Footer",
        "singleton": true,
        "fields": [
          { "name": "id", "type": "uuid PK" },
          { "name": "aboutText_ar", "type": "text", "max": 500 },
          { "name": "aboutText_en", "type": "text", "max": 500 },
          { "name": "logo", "type": "string? (URL)" },
          { "name": "columns", "type": "json (array of {title_ar, title_en, links[]})" },
          { "name": "socialLinks", "type": "json (array of {platform, url, icon})" },
          { "name": "legalLinks", "type": "json (array of {label_ar, label_en, url})" },
          { "name": "copyright_ar", "type": "string", "default": "© {year} {firmName} — جميع الحقوق محفوظة" },
          { "name": "copyright_en", "type": "string", "default": "© {year} {firmName} — All rights reserved" },
          { "name": "showNewsletter", "type": "boolean", "default": true },
          { "name": "newsletterTitle_ar", "type": "string?" },
          { "name": "newsletterTitle_en", "type": "string?" },
          { "name": "showBackToTop", "type": "boolean", "default": true },
          { "name": "showSystemStatus", "type": "boolean", "default": true },
          { "name": "customHtml_ar", "type": "text?" },
          { "name": "customHtml_en", "type": "text?" },
          { "name": "styleConfig", "type": "json (bg color, text color, padding)" },
          { "name": "updatedById", "type": "uuid FK → User" },
          { "name": "updatedAt", "type": "datetime" }
        ]
      },

      "SEOSettings": {
        "purpose": "إعدادات SEO على مستوى النظام + لكل صفحة",
        "fields": [
          { "name": "id", "type": "uuid PK" },
          { "name": "scope", "type": "enum(global|page)", "note": "global للـ default، page للـ override" },
          { "name": "pageKey", "type": "enum(home|about|services|contact)?", "nullable": true, "note": "null للـ global" },

          { "name": "siteName_ar", "type": "string", "max": 100 },
          { "name": "siteName_en", "type": "string", "max": 100 },
          { "name": "titleTemplate", "type": "string", "default": "%s | {siteName}", "example": "من نحن | مكتب العدالة" },
          { "name": "defaultTitle_ar", "type": "string", "max": 60 },
          { "name": "defaultTitle_en", "type": "string", "max": 60 },
          { "name": "defaultDescription_ar", "type": "string", "max": 160 },
          { "name": "defaultDescription_en", "type": "string", "max": 160 },
          { "name": "keywords_ar", "type": "string (csv)" },
          { "name": "keywords_en", "type": "string (csv)" },
          { "name": "defaultOGImage", "type": "string (URL)" },
          { "name": "twitterHandle", "type": "string?", "example": "@lawfirm" },
          { "name": "canonicalBaseUrl", "type": "string", "default": "https://lawfirm.com" },

          { "name": "enableIndexing", "type": "boolean", "default": true },
          { "name": "robotsTxt", "type": "text", "note": "custom robots.txt" },
          { "name": "sitemapEnabled", "type": "boolean", "default": true },
          { "name": "sitemapAutoUpdate", "type": "boolean", "default": true },

          { "name": "googleAnalyticsId", "type": "string?", "example": "G-XXXXXXXX" },
          { "name": "googleSearchConsoleVerification", "type": "string?" },
          { "name": "googleTagManagerId", "type": "string?" },
          { "name": "bingVerification", "type": "string?" },

          { "name": "structuredData", "type": "json", "note": "Organization, LocalBusiness schema" },
          { "name": "hreflang", "type": "json", "default": "{ ar: 'https://lawfirm.com/ar', en: 'https://lawfirm.com/en' }" },

          { "name": "pageTitleOverride_ar", "type": "string?", "max": 60 },
          { "name": "pageTitleOverride_en", "type": "string?", "max": 60 },
          { "name": "pageDescriptionOverride_ar", "type": "string?", "max": 160 },
          { "name": "pageDescriptionOverride_en", "type": "string?", "max": 160 },
          { "name": "pageOGImage", "type": "string?" },
          { "name": "noIndex", "type": "boolean", "default": false, "note": "per page" },
          { "name": "noFollow", "type": "boolean", "default": false },

          { "name": "updatedById", "type": "uuid FK → User" },
          { "name": "updatedAt", "type": "datetime" }
        ],
        "indexes": ["scope", "pageKey"]
      },

      "PublicPageVersion": {
        "purpose": "تاريخ إصدارات الصفحات",
        "fields": [
          { "name": "id", "type": "uuid PK" },
          { "name": "pageKey", "type": "string" },
          { "name": "version", "type": "int" },
          { "name": "snapshot", "type": "json (full page config)" },
          { "name": "changeNote", "type": "text?" },
          { "name": "createdById", "type": "uuid FK → User" },
          { "name": "createdAt", "type": "datetime" }
        ]
      },

      "MediaLibrary": {
        "purpose": "مكتبة الصور والوسائط",
        "fields": [
          { "name": "id", "type": "uuid PK" },
          { "name": "name", "type": "string" },
          { "name": "url", "type": "string" },
          { "name": "type", "type": "string (image/video/document)" },
          { "name": "size", "type": "int" },
          { "name": "width", "type": "int?" },
          { "name": "height", "type": "int?" },
          { "name": "alt_ar", "type": "string?" },
          { "name": "alt_en", "type": "string?" },
          { "name": "folder", "type": "string?", "default": "general" },
          { "name": "uploadedById", "type": "uuid FK → User" },
          { "name": "createdAt", "type": "datetime" }
        ],
        "indexes": ["folder", "type", "createdAt"]
      }
    },

