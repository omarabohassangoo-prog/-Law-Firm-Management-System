  console.log(`  ${paint('red', '❌ Failed:')}  ${fail}`);
  console.log(`  ${paint('yellow', '⚠️  Skipped:')} ${skip}`);
  console.log(`  ${paint('blue', '📋 Total:')}   ${total}`);
  console.log(`  ${paint('blue', '🎯 Success:')} ${rate}%`);

  const byAnnex: Record<string, { pass: number; fail: number; total: number }> = {};
  for (const r of results) {
    if (!byAnnex[r.annex]) byAnnex[r.annex] = { pass: 0, fail: 0, total: 0 };
    byAnnex[r.annex].total++;
    if (r.outcome === 'pass') byAnnex[r.annex].pass++;
    else if (r.outcome === 'fail') byAnnex[r.annex].fail++;
  }
  console.log('\n' + paint('cyan', '  Per-Annex:'));
  for (const [a, s] of Object.entries(byAnnex)) console.log(`  ${s.fail === 0 ? '✅' : '❌'} ${a.padEnd(10)} ${s.pass}/${s.total}`);

  const byModule: Record<string, { pass: number; fail: number; total: number }> = {};
  for (const r of results) {
    if (!byModule[r.module]) byModule[r.module] = { pass: 0, fail: 0, total: 0 };
    byModule[r.module].total++;
    if (r.outcome === 'pass') byModule[r.module].pass++;
    else if (r.outcome === 'fail') byModule[r.module].fail++;
  }
  console.log('\n' + paint('cyan', '  Per-Module (failures highlighted):'));
  for (const [m, s] of Object.entries(byModule)) {
    const icon = s.fail === 0 ? '✅' : '❌';
    if (s.fail > 0 || Object.keys(byModule).length <= 30) console.log(`  ${icon} ${m.slice(0, 45).padEnd(45)} ${s.pass}/${s.total}`);
  }

  const jsonPath = join(OUT_DIR, `master_report_${Date.now()}.json`);
  writeFileSync(jsonPath, JSON.stringify({
    system: 'law-firm-management',
    testSuite: 'API Test Suite via cURL — Single-File Master',
    tool: 'cURL Testing',
    base: BASE, client: CLIENT,
    timestamp: new Date().toISOString(),
    summary: { passed: pass, failed: fail, skipped: skip, total, successRate: `${rate}%` },
    byAnnex, byModule, results,
  }, null, 2), 'utf8');
  console.log(paint('gray', `\n📄 Report (JSON): ${jsonPath}`));

  const md = [
    '# API Test Suite via cURL — Single-File Master',
    '',
    `**Base**: ${BASE}`,
    `**Client**: ${CLIENT}`,
    `**Time**: ${new Date().toISOString()}`,
    '',
    '## Summary',
    `- ✅ Passed: **${pass}**`,
    `- ❌ Failed: **${fail}**`,
    `- ⚠️ Skipped: **${skip}**`,
    `- 📋 Total: **${total}**`,
    `- 🎯 Success: **${rate}%**`,
    '',
    '## Per-Annex',
    '| Annex | Pass | Fail | Total |',
    '|-------|------|------|-------|',
    ...Object.entries(byAnnex).map(([a, s]) => `| ${a} | ${s.pass} | ${s.fail} | ${s.total} |`),
    '',
    '## Failures',
    ...(fail === 0 ? ['- None 🎉'] : results.filter((r) => r.outcome === 'fail').map((r) =>
      `- **${r.module}** → ${r.name} (got ${r.status}, expected ${([] as any[]).concat(r.expected).join('|')})`
    )),
  ].join('\n');
  const mdPath = join(OUT_DIR, `master_report_${Date.now()}.md`);
  writeFileSync(mdPath, md, 'utf8');
  console.log(paint('gray', `📄 Report (MD): ${mdPath}`));

  if (fail > 0) process.exit(1);
}

