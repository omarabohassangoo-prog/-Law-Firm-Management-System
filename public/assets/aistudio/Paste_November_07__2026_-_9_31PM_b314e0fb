// ═══════════════════════════════════════════════════════════════════════════
// 🍪 CSRF
// ═══════════════════════════════════════════════════════════════════════════
function getCsrf(role: Role): string {
  try {
    const jar = cookieJars[role];
    if (!existsSync(jar)) return '';
    return readFileSync(jar, 'utf8').match(/csrf_token\s+(\S+)/)?.[1] ?? '';
  } catch { return ''; }
}

// ═══════════════════════════════════════════════════════════════════════════
// 🔧 CURL CORE
// ═══════════════════════════════════════════════════════════════════════════
interface CurlOpts {
  method?: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE' | 'HEAD';
  path: string; role?: Role; body?: unknown;
  headers?: Record<string, string>;
  expectStatus: number | number[];
  expectJsonKey?: string;
  files?: { field: string; path: string; filename?: string }[];
  outputFile?: string; skipCsrf?: boolean; timeoutMs?: number;
}

function runCurlOnce(opts: CurlOpts): { status: number; body: string; ms: number } {
  const role = opts.role ?? 'public';
  const jar = cookieJars[role];
  const method = opts.method ?? 'GET';
  const timeout = opts.timeoutMs ?? TIMEOUT_MS;

  const args: string[] = [
    '-s', '-X', method, '-w', '\n__STATUS__:%{http_code}',
    '--max-time', String(Math.floor(timeout / 1000)),
    '-b', jar, '-c', jar,
    '-H', `X-Client-Fingerprint: fp-test-${role}`,
  ];
  if (method !== 'GET' && method !== 'HEAD' && !opts.skipCsrf) {
    const csrf = getCsrf(role); if (csrf) args.push('-H', `X-CSRF-Token: ${csrf}`);
  }
  if (opts.headers) for (const [k, v] of Object.entries(opts.headers)) args.push('-H', `${k}: ${v}`);
  if (!opts.files && !opts.outputFile) args.push('-H', 'Content-Type: application/json');
  if (opts.body !== undefined && !opts.files) args.push('-d', JSON.stringify(opts.body));
  if (opts.files) for (const f of opts.files) {
    const ff = f.filename ? `${f.field}=@${f.path};filename=${f.filename}` : `${f.field}=@${f.path}`;
    args.push('-F', ff);
  }
  if (opts.outputFile) args.push('-o', opts.outputFile);
  args.push(`${BASE}${opts.path}`);

  const t0 = Date.now();
  let raw = '';
  try { raw = execFileSync('curl', args, { encoding: 'utf8', timeout }); }
  catch (e: any) { raw = `__STATUS__:000\n__ERR__:${e?.message ?? 'curl failed'}`; }
  const ms = Date.now() - t0;
  const m = raw.match(/__STATUS__:(\d+)/);
  const status = m ? parseInt(m[1], 10) : 0;
  const body = raw.replace(/\n__STATUS__:\d+[\s\S]*$/, '').trim();
  return { status, body, ms };
}

function runCurl(opts: CurlOpts, attempt = 0): { status: number; body: string; ms: number } {
  const r = runCurlOnce(opts);
  // retry on network errors
  if ((r.status === 0 || r.status === 408 || r.status === 502) && attempt < RETRY_MAX) {
    sleep(RETRY_MS);
    return runCurl(opts, attempt + 1);
  }
  return r;
}

function sleep(ms: number) {
  try { execFileSync('sleep', [String(ms / 1000)]); } catch { /* noop */ }
}

function test(opts: CurlOpts, label?: string) {
  const name = label ?? `${opts.method ?? 'GET'} ${opts.path}`;
  sub(name);
  const { status, body, ms } = runCurl(opts);
  const expected = Array.isArray(opts.expectStatus) ? opts.expectStatus : [opts.expectStatus];
  let outcome: Outcome = expected.includes(status) ? 'pass' : 'fail';
  if (outcome === 'pass' && opts.expectJsonKey) {
    try { const j = JSON.parse(body); if (!(opts.expectJsonKey in j)) outcome = 'fail'; }
    catch { outcome = 'fail'; }
  }
  results.push({ name, status, expected: opts.expectStatus, outcome, body: body.slice(0, 300), durationMs: ms, role: opts.role ?? 'public', module: currentModule, annex: currentAnnex });
  const icon = outcome === 'pass' ? '✅' : outcome === 'fail' ? '❌' : '⚠️ ';
  const color = outcome === 'pass' ? 'green' : outcome === 'fail' ? 'red' : 'yellow';
  console.log('  ' + paint(color as any, `${icon} ${name} → ${status} (${ms}ms)`) + (outcome === 'fail' ? paint('gray', `  expected ${expected.join('|')}`) : ''));
  if (outcome === 'fail' && body) console.log(paint('gray', `     body: ${body.slice(0, 200)}`));
  return { status, body };
}

// wrappers
const GET    = (p: string, r: Role, e: number | number[], k?: string) => test({ method: 'GET', path: p, role: r, expectStatus: e, expectJsonKey: k });
const POST   = (p: string, r: Role, e: number | number[], b?: unknown, k?: string) => test({ method: 'POST', path: p, role: r, expectStatus: e, body: b, expectJsonKey: k });
const PATCH  = (p: string, r: Role, e: number | number[], b?: unknown) => test({ method: 'PATCH', path: p, role: r, expectStatus: e, body: b });
const DELETE = (p: string, r: Role, e: number | number[]) => test({ method: 'DELETE', path: p, role: r, expectStatus: e });

function testPage(path: string) {
  sub(`GET ${CLIENT}${path}`);
  try {
    const out = execFileSync('curl', ['-s', '-o', '/dev/null', '-w', '%{http_code}', `${CLIENT}${path}`], { encoding: 'utf8', timeout: 5000 });
    const code = parseInt(out, 10);
    const ok = [200, 404].includes(code);
    results.push({ name: `GET ${path}`, status: code, expected: [200, 404], outcome: ok ? 'pass' : 'fail', durationMs: 0, module: currentModule, annex: currentAnnex });
    console.log('  ' + paint(ok ? 'green' : 'red', `${ok ? '✅' : '❌'} ${path} → ${code}`));
  } catch {
    console.log('  ' + paint('yellow', `⚠️  ${path} skipped (client offline)`));
  }
}

