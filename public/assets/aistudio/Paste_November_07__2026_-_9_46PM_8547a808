```bash
#!/usr/bin/env bash
# scripts/restore.sh — استعادة
set -euo pipefail
FILE="${1:?Usage: $0 <backup.sql.gz>}"
[ -f "$FILE" ] || { echo "Not found: $FILE"; exit 1; }

echo "⚠️  This will overwrite the current database. Ctrl+C to abort."
sleep 5

echo "🔄 Restoring $FILE..."
gunzip -c "$FILE" | docker exec -i lawfirm-pg psql -U postgres -d lawfirm
echo "✅ Restored"
