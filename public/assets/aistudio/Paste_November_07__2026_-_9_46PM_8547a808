```bash
#!/usr/bin/env bash
# scripts/bootstrap.sh — تشغيل من الصفر
set -euo pipefail

BLUE='\033[0;34m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
log() { echo -e "${BLUE}▶${NC} $1"; }
ok()  { echo -e "${GREEN}✅${NC} $1"; }
warn(){ echo -e "${YELLOW}⚠️${NC}  $1"; }

# ─── 1. فحص الأدوات ─────────────────────────────────────────────────────────
log "Checking prerequisites..."
for cmd in node npm docker docker-compose; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Missing: $cmd"; exit 1; }
done
ok "Prerequisites OK"

# ─── 2. ملف .env ────────────────────────────────────────────────────────────
if [ ! -f .env ]; then
  log "Creating .env from template..."
  cp .env.example .env
  ok ".env created (edit if needed)"
fi

# ─── 3. تشغيل Postgres + Redis ──────────────────────────────────────────────
log "Starting Postgres + Redis..."
docker compose up -d postgres redis

log "Waiting for Postgres to be ready..."
until docker exec lawfirm-pg pg_isready -U postgres -d lawfirm >/dev/null 2>&1; do
  sleep 1
done
ok "Postgres is up"

log "Waiting for Redis to be ready..."
until [ "$(docker exec lawfirm-redis redis-cli ping 2>/dev/null)" = "PONG" ]; do
  sleep 1
done
ok "Redis is up"

# ─── 4. تثبيت الحزم ─────────────────────────────────────────────────────────
log "Installing npm dependencies..."
npm ci

# ─── 5. توليد Prisma Client ────────────────────────────────────────────────
log "Generating Prisma Client..."
npx prisma generate
ok "Prisma Client ready"

# ─── 6. تشغيل الترحيلات ─────────────────────────────────────────────────────
log "Applying migrations..."
npx prisma migrate deploy
ok "Migrations applied"

# ─── 7. تحميل البيانات الأولية ─────────────────────────────────────────────
log "Seeding database..."
npx prisma db seed || true
ok "Seed complete"

# ─── 8. تدقيق الصحة ────────────────────────────────────────────────────────
log "Sanity check: counting tables..."
COUNT=$(docker exec lawfirm-pg psql -U postgres -d lawfirm -t -c "SELECT count(*) FROM information_schema.tables WHERE table_schema='public';")
ok "Tables in DB: ${COUNT}"

echo ""
echo -e "${GREEN}🎉 Bootstrap complete!${NC}"
echo "  API:      http://localhost:4000/api"
echo "  Adminer:  http://localhost:8080"
echo "  Admin:    admin@firm.test / Admin@12345"
echo ""
echo "Run:  npm run dev"
```

```bash
#!/usr/bin/env bash
# scripts/migrate.sh — إدارة الترحيلات
set -euo pipefail

case "${1:-}" in
  dev)
    npx prisma migrate dev --name "${2:-manual}"
    ;;
  deploy)
    npx prisma migrate deploy
    ;;
  reset)
    echo "⚠️  This will DROP the database. Ctrl+C to abort."
    sleep 3
    npx prisma migrate reset --force
    ;;
  status)
    npx prisma migrate status
    ;;
  diff)
    npx prisma migrate diff \
      --from-schema-datamodel prisma/schema.prisma \
      --to-url "$DATABASE_URL" \
      --script
    ;;
  *)
    echo "Usage: $0 {dev|deploy|reset|status|diff} [name]"
    exit 1
    ;;
esac
