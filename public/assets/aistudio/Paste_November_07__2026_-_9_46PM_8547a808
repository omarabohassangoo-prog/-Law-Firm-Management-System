1️⃣ Prisma Schema الكامل (نهائي)

```prisma
// prisma/schema.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════
enum Role {
  ADMIN
  LAWYER
  PARALEGAL
  ACCOUNTANT
  SECRETARY
  CLIENT
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING
  CLOSED
  ARCHIVED
}

enum CaseType {
  CIVIL
  CRIMINAL
  COMMERCIAL
  FAMILY
  LABOR
  ADMINISTRATIVE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentMethod {
  PAYPAL
  BANK_TRANSFER
  CASH
  CARD
  ESCROW
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum DisputeStatus {
  OPEN
  EVIDENCE
  RESOLVED
  REJECTED
}

enum EscrowStatus {
  PENDING
  FUNDED
  RELEASED
  DISPUTED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SignatureStatus {
  PENDING
  SIGNED
  VERIFIED
  REJECTED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  EXPORT
  READ
  REVEAL_PII
  CONFLICT_CHECK
  LEGAL_HOLD_SET
  LEGAL_HOLD_RELEASED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ═══════════════════════════════════════════════════════════════════════════
// USERS / AUTH
// ═══════════════════════════════════════════════════════════════════════════
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  phone           String?   @unique
  password        String
  name            String
  role            Role
  tenantId        String    @default("default")
  avatarUrl       String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  twoFAEnabled    Boolean   @default(false)
  twoFASecret     String?
  isActive        Boolean   @default(true)
  isLocked        Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  preferences     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  lawyerCases     Case[]           @relation("LawyerCases")
  clientCases     Case[]           @relation("ClientCases")
  assignedTasks   Task[]           @relation("TaskAssignee")
  createdTasks    Task[]           @relation("TaskCreator")
  sentMessages    Message[]        @relation("MessageSender")
  receivedMessages Message[]       @relation("MessageRecipient")
  documents       Document[]
  docVersions     DocVersion[]
  invoices        Invoice[]        @relation("ClientInvoices")
  createdInvoices Invoice[]        @relation("InvoiceCreator")
  appointmentsAsLawyer Appointment[] @relation("AppointmentLawyer")
  appointmentsAsClient Appointment[] @relation("AppointmentClient")
  signatures      Signature[]
  ethicalWalls    EthicalWall[]
  trustAccounts   TrustAccount[]
  refundsApproved Refund[]
  savedSearches   SavedSearch[]
  subscription    Subscription?

  @@index([role])
  @@index([tenantId])
  @@index([isActive])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  refreshToken  String    @unique
  fingerprint   String
  ipAddress     String?
  userAgent     String?
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// CASES / LEGAL
// ═══════════════════════════════════════════════════════════════════════════
model Case {
  id             String     @id @default(uuid()) @db.Uuid
  caseNumber     String     @unique
  title          String
  description    String?
  type           CaseType
  status         CaseStatus @default(OPEN)
  clientId       String     @db.Uuid
  lawyerId       String     @db.Uuid
  courtId        String?    @db.Uuid
  opposingParty  String?
  openedAt       DateTime   @default(now())
  closedAt       DateTime?
  legalHold      Boolean    @default(false)
  legalHoldReason String?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  client         User       @relation("ClientCases", fields: [clientId], references: [id])
  lawyer         User       @relation("LawyerCases", fields: [lawyerId], references: [id])
  court          Court?     @relation(fields: [courtId], references: [id])
  documents      Document[]
  tasks          Task[]
  hearings       Hearing[]
  deadlines      Deadline[]
  invoices       Invoice[]
  evidence       Evidence[]
  efiling        EFiling[]
  ethicalWalls   EthicalWall[]
  conflicts      ConflictCheck[]

  @@index([clientId])
  @@index([lawyerId])
  @@index([status])
  @@index([type])
  @@index([legalHold])
  @@index([createdAt])
  @@map("cases")
}

model Court {
  id       String          @id @default(uuid()) @db.Uuid
  name     String
  city     String
  type     String
  efiling  Boolean         @default(false)
  cases    Case[]
  holidays CourtHoliday[]

  @@index([city])
  @@map("courts")
}

model CourtHoliday {
  id      String   @id @default(uuid()) @db.Uuid
  courtId String?  @db.Uuid
  date    DateTime
  name    String
  court   Court?   @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("court_holidays")
}

model Hearing {
  id        String   @id @default(uuid()) @db.Uuid
  caseId    String   @db.Uuid
  date      DateTime
  location  String
  notes     String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([date])
  @@map("hearings")
}

model Deadline {
  id       String       @id @default(uuid()) @db.Uuid
  caseId   String       @db.Uuid
  type     String
  date     DateTime
  priority TaskPriority
  done     Boolean      @default(false)
  case     Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, date])
  @@index([date, done])
  @@map("deadlines")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  caseId      String?      @db.Uuid
  assigneeId  String       @db.Uuid
  creatorId   String       @db.Uuid
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  case        Case?        @relation(fields: [caseId], references: [id])
  assignee    User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     User         @relation("TaskCreator", fields: [creatorId], references: [id])

  @@index([assigneeId, completedAt])
  @@index([caseId])
  @@map("tasks")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  senderId    String    @db.Uuid
  recipientId String    @db.Uuid
  caseId      String?   @db.Uuid
  subject     String?
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id])

  @@index([senderId])
  @@index([recipientId, readAt])
  @@map("messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  type      String
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════
// DOCUMENTS / SIGNATURES
// ═══════════════════════════════════════════════════════════════════════════
model Document {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  filePath    String?
  mimeType    String?
  size        Int?
  checksum    String?
  content     String?
  caseId      String?    @db.Uuid
  ownerId     String     @db.Uuid
  encrypted   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation(fields: [ownerId], references: [id])
  case        Case?      @relation(fields: [caseId], references: [id])
  versions    DocVersion[]
  signatures  Signature[]

  @@index([caseId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("documents")
}

model DocVersion {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  version    Int
  content    String?
  filePath   String?
  createdBy  String   @db.Uuid
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator    User     @relation(fields: [createdBy], references: [id])

  @@unique([documentId, version])
  @@map("doc_versions")
}

model Signature {
  id         String          @id @default(uuid()) @db.Uuid
  documentId String          @db.Uuid
  userId     String          @db.Uuid
  signature  String
  hash       String?
  timestamp  String?
  status     SignatureStatus @default(PENDING)
  verified   Boolean         @default(false)
  createdAt  DateTime        @default(now())
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@map("signatures")
}

// ═══════════════════════════════════════════════════════════════════════════
// BILLING / PAYMENTS
// ═══════════════════════════════════════════════════════════════════════════
model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  clientId      String        @db.Uuid
  caseId        String?       @db.Uuid
  creatorId     String        @db.Uuid
  amount        Decimal       @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  total         Decimal       @db.Decimal(14, 2)
  currency      String        @default("SAR")
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  taxId         String?
  zatcaUuid     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation("ClientInvoices", fields: [clientId], references: [id])
  creator       User          @relation("InvoiceCreator", fields: [creatorId], references: [id])
  case          Case?         @relation(fields: [caseId], references: [id])
  payments      Payment[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  invoiceId  String?       @db.Uuid
  amount     Decimal       @db.Decimal(14, 2)
  currency   String        @default("SAR")
  method     PaymentMethod
  status     PaymentStatus @default(PENDING)
  externalId String?
  meta       Json?
  createdAt  DateTime      @default(now())
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id])
  refunds    Refund[]
  disputes   Dispute[]

  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Refund {
  id         String       @id @default(uuid()) @db.Uuid
  paymentId  String       @db.Uuid
  amount     Decimal      @db.Decimal(14, 2)
  reason     String
  status     RefundStatus @default(PENDING)
  approvedBy String?      @db.Uuid
  createdAt  DateTime     @default(now())
  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  approver   User?        @relation(fields: [approvedBy], references: [id])

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

model Dispute {
  id        String        @id @default(uuid()) @db.Uuid
  paymentId String        @db.Uuid
  reason    String
  amount    Decimal       @db.Decimal(14, 2)
  status    DisputeStatus @default(OPEN)
  outcome   String?
  evidence  Json?
  createdAt DateTime      @default(now())
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("disputes")
}

model TrustAccount {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  lawyerId  String   @db.Uuid
  type      String   @default("IOLTA")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  client    User     @relation(fields: [clientId], references: [id])
  txs       TrustTransaction[]

  @@index([clientId])
  @@map("trust_accounts")
}

model TrustTransaction {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @db.Uuid
  type      String
  amount    Decimal      @db.Decimal(14, 2)
  reason    String?
  createdAt DateTime     @default(now())
  account   TrustAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("trust_transactions")
}

model Escrow {
  id         String       @id @default(uuid()) @db.Uuid
  caseId     String       @db.Uuid
  clientId   String       @db.Uuid
  amount     Decimal      @db.Decimal(14, 2)
  currency   String       @default("SAR")
  status     EscrowStatus @default(PENDING)
  fundedAt   DateTime?
  releasedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([caseId])
  @@index([status])
  @@map("escrows")
}

model BillingRule {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  multiplier Decimal  @db.Decimal(5, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@map("billing_rules")
}

model SubscriptionPlan {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  price    Decimal        @db.Decimal(14, 2)
  currency String         @default("SAR")
  interval String
  active   Boolean        @default(true)
  createdAt DateTime      @default(now())
  subs     Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  planId      String             @db.Uuid
  clientId    String             @db.Uuid @unique
  status      SubscriptionStatus @default(ACTIVE)
  startedAt   DateTime           @default(now())
  cancelledAt DateTime?
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  client      User               @relation(fields: [clientId], references: [id])

  @@index([status])
  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// LEGAL / COMPLIANCE
// ═══════════════════════════════════════════════════════════════════════════
