#!/usr/bin/env bash
# scripts/backup.sh — نسخة احتياطية
set -euo pipefail
STAMP=$(date +%Y%m%d_%H%M%S)
DIR="${BACKUP_DIR:-./backups}"
mkdir -p "$DIR"
FILE="$DIR/lawfirm_${STAMP}.sql.gz"

echo "📦 Backing up to $FILE..."
docker exec lawfirm-pg pg_dump -U postgres -d lawfirm --clean --if-exists | gzip > "$FILE"
echo "✅ Backup size: $(du -h "$FILE" | cut -f1)"

# احتفظ بآخر 7 نسخ فقط
ls -1t "$DIR"/lawfirm_*.sql.gz | tail -n +8 | xargs -r rm
echo "🧹 Old backups trimmed (kept 7)"
