{
  "shared_pages_complete": {
    "metadata": {
      "title": "الصفحات المشتركة — Frontend + Backend + Database",
      "version": "1.0.0",
      "scope": "frontend + backend + database + isolation",
      "pages_count": 10,
      "endpoints_count": 42,
      "tables_used": ["Case", "Client", "Document", "Invoice", "Appointment", "Task", "User", "Notification", "ChatRoom", "ChatMember", "ChatMessage", "FirmSettings", "Service"],
      "target": ["AI Studio", "فريق التطوير"],
      "critical_note": "كل صفحة تحتوي على data isolation صارم حسب الدور"
    },

    "universal_patterns": {
      "description": "الأنماط المشتركة بين كل الصفحات",
      
      "data_table_pattern": {
        "component": "DataTable.tsx",
        "features": {
          "search": { "debounce_ms": 300, "min_chars": 2, "placeholder": "بحث..." },
          "sort": { "client_or_server": "server", "indicator": "arrow up/down", "default": "createdAt:desc" },
          "pagination": { "page_sizes": [10, 25, 50, 100], "default": 10, "show_total": true },
          "filters": { "location": "top bar", "persist": "URL query params" },
          "bulk_actions": { "optional": true, "confirmation_required": true },
          "row_actions": { "icons_or_dropdown": "icons on desktop, dropdown on mobile" }
        },
        "states": {
          "loading": "skeleton rows (shimmer)",
          "empty": "icon + message + CTA button",
          "error": "retry button + error message",
          "populated": "data rows + actions"
        },
        "responsive": {
          "mobile": "horizontal scroll + sticky first column",
          "tablet": "hide less important columns",
          "desktop": "full table"
        }
      },

      "form_pattern": {
        "component": "Form + FormFields",
        "validation": {
          "trigger": "onBlur + onSubmit",
          "inline_errors": true,
          "aria": "aria-invalid + aria-describedby"
        },
        "submission": {
          "optimistic_updates": false,
          "loading_state": "button spinner + disabled inputs",
          "success": "toast + close modal + refresh list",
          "error": "inline errors + toast"
        },
        "cancel": "confirmation if dirty"
      },

      "isolation_enforcement": {
        "frontend_guard": "ProtectedRoute with allowedRoles",
        "backend_middleware": "authenticate + requireRole/requirePermission",
        "query_filter": "WHERE role-based condition",
        "data_hiding": "return 404 for unauthorized (not 403) to prevent enumeration",
        "audit": "every write action logged"
      },

      "common_endpoints_pattern": {
        "list": "GET /api/{resource}?page=&pageSize=&search=&sortBy=&sortOrder=&filters...",
        "get": "GET /api/{resource}/:id",
        "create": "POST /api/{resource}",
        "update": "PUT /api/{resource}/:id",
        "delete": "DELETE /api/{resource}/:id"
      }
    },

