        "backend": {
          "module": "src/modules/cases",
          "files": ["cases.routes.ts", "cases.controller.ts", "cases.service.ts", "cases.schema.ts"],

          "endpoints": [
            {
              "method": "GET",
              "path": "/api/cases",
              "auth": "authenticate",
              "permission": "cases.read",
              "query": {
                "page": "number (default 1)",
                "pageSize": "number (default 10, max 100)",
                "search": "string (optional)",
                "status": "CaseStatus (optional)",
                "lawyerId": "uuid (optional — admin only)",
                "clientId": "uuid (optional — admin/secretary)",
                "sortBy": "caseNumber|title|openedAt|status",
                "sortOrder": "asc|desc"
              },
              "service_logic": [
                "1. Extract { userId, role } from req.user",
                "2. Build where clause based on role:",
                "   - admin/secretary → no filter",
                "   - lawyer → where.lawyerId = userId",
                "   - legal_assistant → where.lawyerId IN (SELECT lawyerId FROM Task WHERE assigneeId = userId)",
                "   - client → where.client.userId = userId",
                "3. Add search filter (caseNumber ILIKE OR title ILIKE)",
                "4. Add status filter if provided",
                "5. Add lawyerId filter (admin only)",
                "6. Prisma: findMany with include client.name, lawyer.name",
                "7. Count total for pagination",
                "8. Return { items, total, page, pageSize, totalPages }"
              ],
              "response": {
                "status": 200,
                "body": {
                  "success": true,
                  "data": {
                    "items": [
                      {
                        "id": "uuid",
                        "caseNumber": "CASE-2025-0001",
                        "title": "قضية تجارية",
                        "status": "open",
                        "court": "المحكمة التجارية",
                        "openedAt": "2025-01-01T00:00:00Z",
                        "client": { "id": "uuid", "name": "شركة النور" },
                        "lawyer": { "id": "uuid", "name": "أ. سعيد" }
                      }
                    ],
                    "total": 42,
                    "page": 1,
                    "pageSize": 10,
                    "totalPages": 5
                  }
                }
              },
              "isolation": {
                "admin": "no filter",
                "lawyer": "lawyerId = req.user.userId",
                "legal_assistant": "lawyerId IN assigned",
                "secretary": "read-only, no filter",
                "client": "client.userId = req.user.userId"
              }
            },
            {
              "method": "GET",
              "path": "/api/cases/:id",
              "auth": "authenticate",
              "permission": "cases.read",
              "service_logic": [
                "1. Find case with includes (client, lawyer, documents, invoices)",
                "2. Check isolation: if lawyer role → case.lawyerId must === userId",
                "3. If client role → case.client.userId must === userId",
                "4. If not authorized → return 404 (not 403) to prevent enumeration",
                "5. Return full case details"
              ],
              "response": { "status": 200, "body": { "success": true, "data": "{ ...case, ...includes }" } }
            },
            {
              "method": "POST",
              "path": "/api/cases",
              "auth": "authenticate",
              "permission": "cases.create",
              "roles": ["admin", "lawyer"],
              "body_schema": {
                "type": "object",
                "required": ["title", "clientId"],
                "properties": {
                  "title": { "type": "string", "minLength": 3, "maxLength": 255 },
                  "description": { "type": "string", "maxLength": 2000 },
                  "clientId": { "type": "string", "format": "uuid" },
                  "lawyerId": { "type": "string", "format": "uuid", "nullable": true },
                  "court": { "type": "string", "maxLength": 150 },
                  "status": { "type": "string", "enum": ["open", "pending", "closed", "archived"], "default": "open" }
                }
              },
              "service_logic": [
                "1. Validate client exists",
                "2. If lawyerId provided, validate user is lawyer",
                "3. Auto-generate caseNumber: CASE-{YYYY}-{seq 4 digits}",
                "4. If req.user.role === 'lawyer', force lawyerId = userId",
                "5. Prisma: create case",
                "6. Audit log: action='case.created', entity='Case', entityId=case.id",
                "7. Create notifications for assigned lawyer + admin",
                "8. Return created case"
              ],
              "response": { "status": 201, "body": { "success": true, "data": "{...case}", "message": "تم إنشاء القضية" } }
            },
            {
              "method": "PUT",
              "path": "/api/cases/:id",
              "auth": "authenticate",
              "permission": "cases.update",
              "roles": ["admin", "lawyer"],
              "isolation": "if lawyer → case.lawyerId must === userId",
              "service_logic": [
                "1. Find case + check isolation",
                "2. If lawyer, cannot change lawyerId",
                "3. Update allowed fields only",
                "4. If status changed to 'closed' → set closedAt",
                "5. Audit log: action='case.updated', metadata={ changed fields }",
                "6. Return updated case"
              ],
              "response": { "status": 200, "body": { "success": true, "data": "{...case}", "message": "تم التحديث" } }
            },
            {
              "method": "DELETE",
              "path": "/api/cases/:id",
              "auth": "authenticate",
              "roles": ["admin"],
              "service_logic": [
                "1. Find case",
                "2. Delete associated documents? (soft delete or cascade)",
                "3. Prisma: delete case",
                "4. Audit log: action='case.deleted'",
                "5. Return success"
              ],
              "response": { "status": 200, "body": { "success": true, "message": "تم الحذف" } }
            }
          ],

          "service_queries": {
            "generate_case_number": {
              "logic": "SELECT COALESCE(MAX(CAST(SUBSTRING(caseNumber FROM 'CASE-\\d{4}-(\\d+)') AS INT)), 0) + 1 FROM Case WHERE caseNumber LIKE 'CASE-{year}-%'",
              "note": "Race condition handled via DB unique constraint + retry"
            },
            "list_by_role": {
              "admin": "SELECT * FROM Case",
              "lawyer": "SELECT * FROM Case WHERE lawyerId = $userId",
              "client": "SELECT c.* FROM Case c JOIN Client cl ON c.clientId = cl.id WHERE cl.userId = $userId"
            }
          }
        },

        "database": {
          "tables": ["Case", "Client", "User", "Document", "Invoice", "AuditLog", "Notification"],
          "queries": [
            "SELECT * FROM Case WHERE [role-based-filter] AND [search] ORDER BY [sort] LIMIT $take OFFSET $skip",
            "INSERT INTO Case (id, caseNumber, title, description, status, court, clientId, lawyerId, openedAt, createdAt, updatedAt) VALUES (...) RETURNING *",
            "UPDATE Case SET title=$1, description=$2, status=$3, court=$4, lawyerId=$5, closedAt=$6, updatedAt=NOW() WHERE id=$7",
            "DELETE FROM Case WHERE id=$1",
            "INSERT INTO AuditLog (userId, action, entity, entityId, metadata, ipAddress, userAgent) VALUES (...)"
          ],
          "indexes_used": ["idx_case_caseNumber", "idx_case_status", "idx_case_clientId", "idx_case_lawyerId", "idx_case_openedAt"],
          "unique_constraints": ["caseNumber"]
        },

        "isolation_tests": {
          "total": 48,
          "scenarios": [
            { "role": "admin", "test": "sees all cases", "scenarios_count": 8 },
            { "role": "lawyer", "test": "sees only own cases (lawyerId=self)", "scenarios_count": 12 },
            { "role": "lawyer", "test": "cannot edit other's cases (404)", "scenarios_count": 4 },
            { "role": "legal_assistant", "test": "sees only assigned", "scenarios_count": 6 },
            { "role": "secretary", "test": "read-only, cannot edit", "scenarios_count": 4 },
            { "role": "client", "test": "sees only own cases (client.userId=self)", "scenarios_count": 12 },
            { "role": "client", "test": "cannot see other's cases (404)", "scenarios_count": 2 }
          ]
        }
      },

