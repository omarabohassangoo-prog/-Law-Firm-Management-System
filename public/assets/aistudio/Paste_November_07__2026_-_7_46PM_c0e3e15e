{
  "template_preview_test_plan": {
    "metadata": {
      "title": "مخطط معاينة واختبار القوالب",
      "version": "1.0.0",
      "scope": "Preview + Test Send + Validation for all channels",
      "channels": ["email", "sms", "whatsapp", "push"],
      "access_level": "admin only",
      "target": ["AI Studio", "فريق التطوير"]
    },

    "overview": {
      "purpose": "تمكين مدير المكتب من معاينة القوالب واختبارها قبل التفعيل",
      "features": [
        "👁️ Live Preview (فوري أثناء التعديل)",
        "📱 Multi-device Preview (desktop/tablet/mobile)",
        "🌐 Multi-locale Preview (AR/EN)",
        "🌓 Dark Mode Preview",
        "📧 Inbox Preview (كيف يظهر في Gmail/Outlook)",
        "🧪 Test Send (إرسال حقيقي)",
        "📊 Validation (تحقق قبل الإرسال)",
        "💰 Cost Warning (تحذير التكلفة)",
        "📋 Delivery Log (سجل الإرسال)",
        "🔄 Batch Test (اختبار متعدد)"
      ]
    },

    "preview_system": {
      "live_preview": {
        "description": "معاينة مباشرة تتحدث مع كل تعديل",
        "layout": {
          "desktop": "split-screen (editor left 50%, preview right 50%)",
          "tablet": "split-screen (60/40)",
          "mobile": "tabs (Editor | Preview)"
        },
        "update_trigger": {
          "on_change": true,
          "debounce": 300,
          "method": "POST /api/templates/preview (with current form data, not saved)",
          "note": "Preview يستخدم بيانات النموذج الحالية وليس المحفوظة"
        },
        "loading_state": "skeleton/spinner while rendering"
      },

      "preview_controls": {
        "device_switcher": {
          "options": ["desktop", "tablet", "mobile"],
          "widths": { "desktop": "100% (max 700px)", "tablet": "768px", "mobile": "375px" },
          "default": "desktop"
        },
        "locale_switcher": {
          "options": ["ar", "en"],
          "affects": "direction (RTL/LTR) + font + content",
          "default": "template locale"
        },
        "theme_switcher": {
          "options": ["light", "dark"],
          "affects": "preview background only",
          "default": "light"
        },
        "zoom": {
          "options": ["50%", "75%", "100%", "fit"],
          "default": "100%"
        },
        "variable_fill": {
          "description": "ملء المتغيرات ببيانات تجريبية",
          "sources": [
            { "type": "sample_data", "label": "بيانات تجريبية افتراضية" },
            { "type": "real_data", "label": "بيانات من قضية/عميل حقيقي" },
            { "type": "manual", "label": "إدخال يدوي" }
          ]
        }
      },

      "preview_renderers": {
        "email": {
          "renderer": "HTML with inline styles",
          "preview_modes": [
            { "id": "desktop", "label": "سطح المكتب", "width": "700px" },
            { "id": "mobile", "label": "جوال", "width": "375px" },
            { "id": "outlook", "label": "Outlook", "note": "tested for compatibility" },
            { "id": "gmail", "label": "Gmail", "note": "tested for compatibility" }
          ],
          "inbox_preview": {
            "description": "عرض كيف يبدو البريد في صندوق الوارد",
            "shows": ["sender_name", "sender_email", "subject", "preheader", "timestamp"],
            "mockup_style": "inbox row similar to Gmail"
          },
          "metadata_check": {
            "shows": ["subject_length", "preheader_length", "total_size_kb", "images_count", "links_count"],
            "warnings": [
              { "condition": "subject_length > 60", "message": "الموضوع طويل — قد يُقطع في بعض العملاء" },
              { "condition": "preheader_length > 100", "message": "Preheader طويل — سيُقطع" },
              { "condition": "images_count > 5", "message": "عدد كبير من الصور — قد يبطئ التحميل" },
              { "condition": "total_size_kb > 100", "message": "حجم القالب كبير — قد يدخل Spam" }
            ]
          }
        },

        "sms": {
          "renderer": "Plain text with variable substitution",
          "preview_modes": [
            { "id": "iphone", "label": "iPhone (iOS Messages)", "style": "iOS-style bubble" },
            { "id": "android", "label": "Android (Messages)", "style": "Material style" }
          ],
          "character_counter": {
            "shows": ["current_length", "max_length (160 or 70 unicode)", "remaining", "sms_segments"],
            "colors": {
              "safe": "green (< 140)",
              "warning": "amber (140-160)",
              "danger": "red (> 160, multiple segments)"
            }
          },
          "unicode_warning": {
            "condition": "contains non-ASCII chars (Arabic, emoji)",
            "message": "القالب يحتوي على أحرف Unicode — سيُحسب كل 70 حرف كـ SMS منفصل"
          }
        },

        "whatsapp": {
          "renderer": "Meta components format",
          "preview_modes": [
            { "id": "iphone", "label": "iPhone (WhatsApp)" },
            { "id": "android", "label": "Android (WhatsApp)" }
          ],
          "style": "WhatsApp-style chat bubble (green for outgoing)",
          "shows": ["header", "body", "footer", "buttons"],
          "template_validation": {
            "checks": [
              { "check": "template_name approved", "message": "القالب غير معتمد في Meta" },
              { "check": "parameters_count correct", "message": "عدد المتغيرات لا يطابق القالب" },
              { "check": "buttons <= 3", "message": "الحد الأقصى 3 أزرار" }
            ]
          }
        },

        "push": {
          "renderer": "Web Push payload",
          "preview_modes": [
            { "id": "chrome_desktop", "label": "Chrome Desktop", "style": "native OS notification" },
            { "id": "chrome_android", "label": "Chrome Android", "style": "material notification" },
            { "id": "firefox", "label": "Firefox", "style": "minimal notification" }
          ],
          "character_limits": {
            "title": 65,
            "body": 120,
            "warning_when": { "title": 55, "body": 100 }
          },
          "shows": ["icon", "title", "body", "actions", "timestamp"]
        }
      },

