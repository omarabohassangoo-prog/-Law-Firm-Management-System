      "responsive_preview": {
        "device_frames": {
          "desktop": "browser window (with URL bar)",
          "tablet": "iPad frame",
          "mobile": "iPhone/Android frame"
        },
        "orientation": ["portrait", "landscape"],
        "responsive_warnings": [
          "النص قد يكون صغيراً جداً على الجوال",
          "الصورة قد تكون كبيرة على الشاشات الصغيرة",
          "الزر قد يكون صغيراً للنقر باللمس (< 44px)"
        ]
      }
    },

