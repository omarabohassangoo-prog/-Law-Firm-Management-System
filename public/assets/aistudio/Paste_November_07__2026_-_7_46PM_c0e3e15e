            { "text": "إلغاء", "secondary": true }
          ]
        }
      },

      "test_execution": {
        "steps": [
          "1. Validation (كامل - 5 stages)",
          "2. Confirm cost (if SMS/WhatsApp)",
          "3. Rate limit check (max 3/min per template)",
          "4. Load template + variables",
          "5. Render with variables",
          "6. Enqueue in appropriate queue",
          "7. Log to Test Log (pending)",
          "8. Send via provider",
          "9. Update Test Log (sent/failed)",
          "10. Emit real-time update to admin"
        ],
        "success_response": {
          "message": "✅ تم إرسال الاختبار بنجاح",
          "details": {
            "target": "string",
            "sent_at": "ISO",
            "cost_estimate": "$0.05",
            "delivery_id": "uuid",
            "check_inbox_message": "تحقق من بريدك/هاتفك"
          }
        },
        "failure_response": {
          "message": "❌ فشل الإرسال",
          "error": "specific error message",
          "suggestions": ["hint 1", "hint 2"],
          "retry_button": true
        }
      },

      "test_history": {
        "description": "سجل كل الاختبارات",
        "endpoint": "GET /api/templates/:id/tests",
        "table_columns": [
          { "key": "createdAt", "label": "التاريخ" },
          { "key": "target", "label": "المرسل إليه" },
          { "key": "status", "label": "النتيجة", "badge": true },
          { "key": "cost", "label": "التكلفة" },
          { "key": "actions", "label": "إجراءات", "buttons": ["view_error", "resend"] }
        ],
        "filters": ["status", "date_range"],
        "retention": "90 days (configurable)"
      }
    },

    "batch_testing": {
      "description": "اختبار عدة قوالب معاً",
      "endpoint": "POST /api/templates/batch-test",
      "use_case": "تحقق من كل قوالب حدث معين بعد تغييرها",
      "fields": [
        { "name": "templateIds", "type": "multi-select", "required": true },
        { "name": "target", "type": "string (email or phone)", "required": true },
        { "name": "variables", "type": "from preview defaults" }
      ],
      "execution": "queue-based, parallel with concurrency limit",
      "cost_estimate": "sum of all channels",
      "progress": "real-time updates via socket"
    },

    "delivery_tracking": {
      "description": "تتبع حالة كل إرسال (test or production)",
      "realtime_updates": {
        "via": "Socket.IO",
        "events": [
          { "event": "delivery:sent", "data": "deliveryId, status" },
          { "event": "delivery:failed", "data": "deliveryId, error" }
        ]
      },
      "webhook_tracking": {
        "providers": {
          "sendgrid": "opens + clicks + bounces",
          "twilio": "delivery status + cost",
          "meta_whatsapp": "delivered + read receipts",
          "push": "delivered (best effort)"
        },
        "integration": "POST /api/webhooks/{provider}/delivery"
      }
    },

