        "variable_picker": {
          "description": "شريط جانبي لإدخال المتغيرات",
          "layout": "right panel or modal",
          "features": [
            "Auto-fill with sample data button",
            "Copy real values from a case/client",
            "Manual input for each",
            "Reset to defaults",
            "Show which variables are unused"
          ]
