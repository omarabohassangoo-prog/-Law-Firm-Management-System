          }
        },
        {
          "stage": 4,
          "name": "Style Validation",
          "checks": [
            { "id": "colors_valid_hex", "message": "لون غير صالح (يجب hex)" },
            { "id": "contrast_ok", "message": "تباين الألوان ضعيف (WCAG AA)" },
            { "id": "font_size_range", "message": "حجم الخط خارج النطاق المسموح" },
            { "id": "padding_range", "message": "الحشو خارج النطاق" }
