          "name": "Basic Validation",
          "checks": [
            { "id": "name_not_empty", "message": "الاسم مطلوب" },
            { "id": "name_unique_per_channel", "message": "اسم القالب مستخدم بالفعل" },
            { "id": "channel_selected", "message": "القناة مطلوبة" },
            { "id": "event_selected", "message": "الحدث مطلوب" },
            { "id": "locale_selected", "message": "اللغة مطلوبة" }
          ]
        },
        {
          "stage": 2,
          "name": "Content Validation",
          "checks": [
            { "id": "body_not_empty", "message": "محتوى القالب مطلوب" },
            { "id": "variables_valid", "message": "متغيرات غير معروفة" },
            { "id": "variables_allowed_for_event", "message": "متغير لا ينطبق على هذا الحدث" },
            { "id": "no_unclosed_variables", "message": "متغير غير مغلق {name" },
            { "id": "no_invalid_html", "message": "HTML غير صالح في القالب" }
          ]
        },
        {
          "stage": 3,
          "name": "Channel-specific Validation",
          "by_channel": {
            "email": [
              { "id": "subject_required", "message": "موضوع البريد مطلوب" },
              { "id": "subject_length", "message": "موضوع البريد > 150 حرف" },
              { "id": "valid_links", "message": "روابط غير صالحة" },
              { "id": "no_js_scripts", "message": "JavaScript غير مسموح في البريد" }
            ],
            "sms": [
              { "id": "length_ok", "message": "النص > 160 حرف" },
              { "id": "unicode_check", "message": "الأحرف العربية تقلل الحد إلى 70 حرف" }
            ],
            "whatsapp": [
              { "id": "template_approved", "message": "القالب غير معتمد في Meta" },
              { "id": "parameters_count", "message": "عدد المتغيرات لا يطابق القالب المعتمد" },
              { "id": "buttons_max_3", "message": "الحد الأقصى 3 أزرار" }
            ],
            "push": [
              { "id": "title_required", "message": "العنوان مطلوب" },
              { "id": "title_length", "message": "العنوان > 65 حرف" },
              { "id": "body_required", "message": "المحتوى مطلوب" },
              { "id": "body_length", "message": "المحتوى > 120 حرف" },
