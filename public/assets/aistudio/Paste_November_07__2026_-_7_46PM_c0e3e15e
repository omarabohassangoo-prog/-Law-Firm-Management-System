      }
    },

    "test_send_system": {
      "description": "إرسال تجريبي حقيقي للقالب قبل التفعيل",

      "test_modal": {
        "trigger_from": [
          { "from": "templates_list", "button": "أيقونة إرسال تجريبي في كل بطاقة" },
          { "from": "template_editor", "button": "زر 'إرسال تجريبي' في الأعلى" },
          { "from": "template_preview", "button": "زر 'إرسال تجريبي' أسفل Preview" }
        ],
        "layout": {
          "fields": [
            {
              "name": "target",
              "type": "dynamic",
              "by_channel": {
                "email": {
                  "field": "email",
                  "label": "البريد الإلكتروني",
                  "required": true,
                  "default": "current admin email",
                  "validation": "valid email format"
                },
                "sms": {
                  "field": "phone",
                  "label": "رقم الهاتف",
                  "required": true,
                  "default": "current admin phone",
                  "validation": "E.164 format (+966...)"
                },
                "whatsapp": {
                  "field": "phone",
                  "label": "رقم WhatsApp",
                  "required": true,
                  "validation": "must have WhatsApp"
                },
                "push": {
                  "field": "userId",
                  "label": "المستخدم",
                  "type": "select",
                  "options": "admin users only",
                  "default": "current admin"
                }
              }
            },
            {
              "name": "variables",
              "type": "key_value_pairs",
              "label": "قيم المتغيرات",
              "prefilled": "from preview sample data",
              "editable": true
            },
            {
              "name": "notes",
              "type": "textarea",
              "label": "ملاحظات (اختياري)",
              "note": "stored in Test log for reference"
            }
          ],
          "cost_warning": {
            "display": "prominent yellow alert",
            "by_channel": {
              "email": "🟢 بدون تكلفة (~$0)",
              "sms": "⚠️ تكلفة ~$0.05 لكل رسالة",
              "whatsapp": "⚠️ تكلفة ~$0.01 لكل رسالة",
              "push": "🟢 بدون تكلفة"
            },
            "monthly_total_shown": "إجمالي المرسل هذا الشهر: XX"
