    "api_endpoints": {
      "preview": [
        {
          "method": "POST",
          "path": "/api/templates/preview",
          "auth": "admin",
          "body": {
            "channel": "email|sms|whatsapp|push",
            "template": "TemplateInput (form data, not saved)",
            "variables": "Record<string, string>",
            "locale": "ar|en"
          },
          "returns": {
            "success": true,
            "data": {
              "html": "string (email)",
              "text": "string (sms)",
              "components": "array (whatsapp)",
              "payload": "object (push)",
              "metadata": {
                "size_kb": "number",
                "character_count": "number",
                "warnings": "array"
              }
            }
          }
        },
        {
          "method": "POST",
          "path": "/api/templates/:id/preview",
          "auth": "admin",
          "body": "{ variables, locale }",
          "returns": "same as above"
        }
      ],
      "validation": [
        {
          "method": "POST",
          "path": "/api/templates/validate",
          "auth": "admin",
          "body": "{ channel, template }",
          "returns": {
            "valid": "boolean",
            "errors": [{ "field", "message", "severity" }],
            "warnings": [{ "field", "message" }]
          }
        }
      ],
      "test_send": [
        {
          "method": "POST",
          "path": "/api/templates/:id/test",
          "auth": "admin",
          "rate_limit": "3/min per template",
          "body": {
            "target": "string (email or phone or userId)",
            "variables": "Record<string, string>",
            "notes": "string?"
          },
          "returns": {
            "success": true,
            "data": {
              "deliveryId": "uuid",
              "target": "string",
              "sentAt": "ISO",
              "costEstimate": "$0.05"
            }
          }
        },
        {
          "method": "GET",
          "path": "/api/templates/:id/tests",
          "auth": "admin",
          "query": "page, pageSize, status"
        },
        {
          "method": "DELETE",
          "path": "/api/templates/tests/:deliveryId",
          "auth": "admin",
          "note": "cleanup test history"
        }
      ],
      "batch_test": [
        {
          "method": "POST",
          "path": "/api/templates/batch-test",
          "auth": "admin",
          "body": { "templateIds": "array", "target": "string", "variables": "object" }
        }
      ]
